{
  "name": "adlc-security-reviewer",
  "version": "0.2.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "engines": { "node": ">=22.13" },
  "scripts": {
    "test": "node tools/lock.mjs --verify && node --test \"agents/security-reviewer/test/*.test.mjs\"",
    "conformance": "node conformance/security-reviewer-check.mjs --cmd \"node --permission --allow-fs-read='*' agents/security-reviewer/scripts/review.mjs\"",
    "removal": "node tools/removal-check.mjs",
    "verify": "npm test && npm run conformance && npm run removal"
  }
}
